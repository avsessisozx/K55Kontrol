<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Renk paleti -->
    <Color x:Key="ArkaplanRengi">#0F1115</Color>
    <Color x:Key="VurguRengi">#5B8CFF</Color>
    <SolidColorBrush x:Key="Arkaplan" Color="#0F1115"/>
    <SolidColorBrush x:Key="YanPanel" Color="#14171D"/>
    <SolidColorBrush x:Key="Kart" Color="#181B22"/>
    <SolidColorBrush x:Key="KartUst" Color="#20242D"/>
    <SolidColorBrush x:Key="KartUzeri" Color="#272C37"/>
    <SolidColorBrush x:Key="Cizgi" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="Girdi" Color="#12141A"/>
    <SolidColorBrush x:Key="Metin" Color="#E8EAF0"/>
    <SolidColorBrush x:Key="IkincilMetin" Color="#9AA1B2"/>
    <SolidColorBrush x:Key="SolukMetin" Color="#6B7280"/>
    <SolidColorBrush x:Key="Vurgu" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="VurguAcik" Color="#7FA6FF"/>
    <SolidColorBrush x:Key="VurguZemin" Color="#1E2A4A"/>
    <SolidColorBrush x:Key="Basari" Color="#34D399"/>
    <SolidColorBrush x:Key="Uyari" Color="#FBBF24"/>
    <SolidColorBrush x:Key="UyariZemin" Color="#2E2610"/>
    <SolidColorBrush x:Key="Tehlike" Color="#F87171"/>

    <FontFamily x:Key="Yazi">Segoe UI</FontFamily>
    <FontFamily x:Key="Simgeler">Segoe MDL2 Assets</FontFamily>

    <!-- Metin stilleri -->
    <Style x:Key="SayfaBasligi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
    </Style>
    <Style x:Key="BolumBasligi" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource IkincilMetin}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Aciklama" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource SolukMetin}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Kart -->
    <Style x:Key="KartKutusu" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Kart}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cizgi}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Yan menü düğmesi -->
    <Style x:Key="MenuDugmesi" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource IkincilMetin}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Zemin" Background="Transparent" CornerRadius="10" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Simge" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Simgeler}"
                                       FontSize="16" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource KartUst}"/>
                            <Setter Property="Foreground" Value="{StaticResource Metin}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource VurguZemin}"/>
                            <Setter Property="Foreground" Value="{StaticResource Metin}"/>
                            <Setter TargetName="Simge" Property="Foreground" Value="{StaticResource VurguAcik}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Profil hapı -->
    <Style x:Key="ProfilHapi" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource IkincilMetin}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Zemin" Background="{StaticResource KartUst}" BorderBrush="{StaticResource Cizgi}"
                            BorderThickness="1" CornerRadius="17" Padding="16,7">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource SolukMetin}"/>
                            <Setter Property="Foreground" Value="{StaticResource Metin}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource Vurgu}"/>
                            <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Efekt kartı: Tag = önizleme fırçası, Content = başlık, ToolTip yerine DataContext = açıklama -->
    <Style x:Key="EfektKarti" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Zemin" Background="{StaticResource KartUst}" BorderBrush="{StaticResource Cizgi}"
                            BorderThickness="2" CornerRadius="12" Padding="10">
                        <StackPanel>
                            <Border CornerRadius="7" Height="44" Background="{TemplateBinding Tag}"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" FontWeight="SemiBold" Margin="2,10,0,2"/>
                            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource SolukMetin}"
                                       TextWrapping="Wrap" Margin="2,0,0,0" Height="32"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource KartUzeri}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}"/>
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource VurguZemin}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liste kartı (profil listesi) -->
    <Style x:Key="ListeKarti" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Zemin" Background="{StaticResource KartUst}" BorderBrush="{StaticResource Cizgi}"
                            BorderThickness="2" CornerRadius="10" Padding="14,10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource KartUzeri}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}"/>
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource VurguZemin}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Düğmeler -->
    <Style x:Key="TemelDugme" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="Background" Value="{StaticResource KartUst}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cizgi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Zemin" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Zemin" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Zemin" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BirincilDugme" TargetType="Button" BasedOn="{StaticResource TemelDugme}">
        <Setter Property="Background" Value="{StaticResource Vurgu}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Vurgu}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="TehlikeDugme" TargetType="Button" BasedOn="{StaticResource TemelDugme}">
        <Setter Property="Foreground" Value="{StaticResource Tehlike}"/>
    </Style>
    <Style x:Key="BaslikDugmesi" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource IkincilMetin}"/>
        <Setter Property="FontFamily" Value="{StaticResource Simgeler}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Zemin" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource KartUst}"/>
                            <Setter Property="Foreground" Value="{StaticResource Metin}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KapatDugmesi" TargetType="Button" BasedOn="{StaticResource BaslikDugmesi}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Zemin" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kaydırıcı -->
    <Style x:Key="KaydiriciDolgu" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" Height="6" CornerRadius="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource KaydiriciDolgu}" Background="{StaticResource Vurgu}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource KaydiriciDolgu}" Background="{StaticResource KartUzeri}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="18" Height="18" Fill="White" Stroke="{StaticResource Vurgu}" StrokeThickness="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Açma/kapama anahtarı -->
    <Style x:Key="Anahtar" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Border x:Name="Ray" Grid.Column="1" Width="44" Height="24" CornerRadius="12"
                                Background="{StaticResource KartUzeri}" BorderBrush="{StaticResource Cizgi}" BorderThickness="1">
                            <Ellipse x:Name="Topuz" Width="16" Height="16" Fill="{StaticResource IkincilMetin}"
                                     HorizontalAlignment="Left" Margin="4,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ray" Property="Background" Value="{StaticResource Vurgu}"/>
                            <Setter TargetName="Ray" Property="BorderBrush" Value="{StaticResource Vurgu}"/>
                            <Setter TargetName="Topuz" Property="Fill" Value="White"/>
                            <Setter TargetName="Topuz" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Metin kutusu -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="Background" Value="{StaticResource Girdi}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cizgi}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Metin}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Vurgu}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Zemin" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Açılır liste -->
    <Style x:Key="AcilirDugme" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Zemin" Background="{StaticResource Girdi}" BorderBrush="{StaticResource Cizgi}"
                            BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Simgeler}" FontSize="10"
                                   Foreground="{StaticResource IkincilMetin}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource SolukMetin}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Zemin" Property="BorderBrush" Value="{StaticResource Vurgu}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource AcilirDugme}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                          VerticalAlignment="Center" Margin="12,0,34,0"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource KartUst}" BorderBrush="{StaticResource Cizgi}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Zemin" Background="Transparent" CornerRadius="6" Padding="10,7">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource KartUzeri}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Zemin" Property="Background" Value="{StaticResource VurguZemin}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- İnce kaydırma çubuğu -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource KartUzeri}" CornerRadius="4" Margin="1"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Koyu araç ipucu -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource KartUst}"/>
        <Setter Property="Foreground" Value="{StaticResource Metin}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Cizgi}"/>
    </Style>
</ResourceDictionary>
